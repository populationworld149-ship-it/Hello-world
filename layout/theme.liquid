<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Optional font (fallbacks to system fonts if blocked) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Cafe template styles (scoped via .cafe-template body class) -->
    {{ 'cafe-template.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="cafe-template">
    <!-- Decorative flowers (flat/vector-style placeholders) -->
    <div class="decor" aria-hidden="true">
      <div class="flower flower--1"></div>
      <div class="flower flower--2"></div>
      <div class="flower flower--3"></div>
      <div class="flower flower--4"></div>
    </div>

    <header class="topbar" data-fade>
      <!-- Logo click → About page -->
      <a
        class="logo"
        data-fade-logo
        href="{{ pages['about'].url | default: '/pages/about' }}"
        aria-label="Go to About page"
      >
        <span class="logo__mark" aria-hidden="true"></span>
        <span class="logo__text">Logo</span>
      </a>

      <nav class="topnav" aria-label="Primary navigation">
        <!-- Keep href as a fallback; JS prevents default to open modal -->
        <a class="topnav__link" href="{{ routes.account_url }}" data-open-account>Account</a>
        <a class="topnav__link" href="{{ routes.cart_url }}">
          Cart
          <span class="pill" data-cart-count>{{ cart.item_count }}</span>
        </a>
      </nav>
    </header>

    <main id="MainContent">
      {%- comment -%}
        Home page: responsive 3-column menu (categories / plate / details)
        Cart page: custom cart UI (localStorage-backed demo)
        About page (page handle "about"): simple about layout
        Everything else: default Shopify template output
      {%- endcomment -%}

      {% if template.name == 'index' %}
        <main class="layout">
          <!-- Left: categories (desktop) / horizontal tabs (mobile) -->
          <aside class="categories" data-fade>
            <h2 class="sr-only">Categories</h2>
            <div class="categories__list" role="tablist" aria-label="Menu categories" data-categories></div>
          </aside>

          <!-- Center: plate/display area -->
          <section class="plate-area" aria-label="Menu items">
            <div class="plate plate--enter" data-plate>
              <div class="plate__header" data-fade>
                <h1 class="h1" data-category-title>Category A</h1>
                <p class="muted" data-category-desc>Placeholder description for the selected category.</p>
              </div>
              <div class="items-grid" data-items></div>
            </div>
          </section>

          <!-- Right: details panel (desktop) / below on mobile -->
          <aside class="details" data-fade aria-label="Selected item details">
            <div class="details__card">
              <div class="thumb" aria-hidden="true">
                <div class="thumb__art"></div>
              </div>

              <div class="details__body">
                <h2 class="h2" data-item-title>Item 1</h2>
                <p class="muted" data-item-desc>
                  Placeholder item description. Swap this text later with real details.
                </p>

                <div class="row">
                  <div class="price" data-item-price>$0.00</div>
                  <div class="chip" data-item-category>Category A</div>
                </div>

                <div class="actions">
                  <button class="btn btn--primary" type="button" data-add-to-order>Add to Order</button>
                  <button class="btn btn--ghost" type="button" data-open-ingredients>Ingredients</button>
                </div>

                <p class="note">Pickup only (delivery coming soon).</p>
              </div>
            </div>
          </aside>
        </main>

      {% elsif template.name == 'cart' %}
        <main class="page" data-fade>
          <section class="page__hero">
            <div class="hero__art hero__art--cart" aria-hidden="true"></div>
            <div>
              <h1 class="h1">Cart / Order</h1>
              <p class="muted">Pickup only (delivery coming soon).</p>
            </div>
          </section>

          <section class="cart">
            <div class="card">
              <h3 class="h3">Items</h3>
              <div class="cart__list" data-cart-list></div>
              <div class="cart__empty muted" data-cart-empty hidden>
                Your cart is empty. Go back to the menu and add an item.
              </div>
            </div>

            <div class="card">
              <h3 class="h3">Summary</h3>
              <div class="row row--space">
                <span class="muted">Total</span>
                <strong data-cart-total>$0.00</strong>
              </div>
              <button class="btn btn--primary" type="button" data-place-order>Place Order</button>
              <p class="muted" data-order-status></p>
            </div>
          </section>
        </main>

      {% elsif template.name == 'page' and page.handle == 'about' %}
        <main class="page" data-fade>
          <section class="page__hero">
            <div class="hero__art" aria-hidden="true"></div>
            <div>
              <h1 class="h1">About</h1>
              <p class="muted">
                Placeholder cafe/business info. Replace this copy with your real story, hours,
                location, and brand voice later.
              </p>
              <div class="card">
                <h4 class="h4">Pickup Only</h4>
                <p class="muted">Pickup only (delivery coming soon).</p>
              </div>
            </div>
          </section>

          <section class="page__grid">
            <div class="card">
              <h3 class="h3">What We Offer</h3>
              <p class="muted">Placeholder categories and clean 2D illustration style.</p>
              <ul class="list">
                <li>Category A</li>
                <li>Category B</li>
                <li>Category C</li>
              </ul>
            </div>
            <div class="card">
              <h3 class="h3">Brand Feel</h3>
              <p class="muted">
                Pink + white backgrounds, dark blue text/buttons, lots of whitespace, and smooth animations.
              </p>
            </div>
            <div class="card">
              <h3 class="h3">Contact</h3>
              <p class="muted">
                Placeholder contact info. Use the chat button for questions about ingredients/allergies.
              </p>
            </div>
          </section>
        </main>

      {% else %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    <!-- Ingredients Modal -->
    <dialog class="modal" data-modal="ingredients" aria-label="Ingredients and allergen info">
      <div class="modal__card">
        <button class="icon-btn modal__close" type="button" data-close-modal aria-label="Close">✕</button>
        <div class="modal__header">
          <div class="modal__art" aria-hidden="true"></div>
          <div>
            <h3 class="h3" data-ing-title>Ingredients</h3>
            <p class="muted" data-ing-subtitle>Notepad-style placeholder info.</p>
          </div>
        </div>

        <div class="modal__content">
          <div class="notepad">
            <h4 class="h4">Ingredients (placeholder)</h4>
            <ul class="list" data-ing-list></ul>

            <h4 class="h4">Allergens (placeholder)</h4>
            <div class="allergens" data-allergen-list></div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Account Modal -->
    <dialog class="modal" data-modal="account" aria-label="Account and loyalty program">
      <div class="modal__card">
        <button class="icon-btn modal__close" type="button" data-close-modal aria-label="Close">✕</button>
        <div class="modal__header">
          <div class="modal__art modal__art--account" aria-hidden="true"></div>
          <div>
            <h3 class="h3">Account</h3>
            <p class="muted">Placeholder user info + loyalty program.</p>
          </div>
        </div>
        <div class="modal__content">
          <div class="card">
            <div class="card__row">
              <div>
                <div class="label">Name</div>
                <div class="value">User Name</div>
              </div>
              <div>
                <div class="label">Email</div>
                <div class="value">user@example.com</div>
              </div>
            </div>
          </div>

          <div class="card">
            <h4 class="h4">Loyalty Program</h4>
            <p class="muted">
              You earn <strong>+1 point</strong> per added item (stored in localStorage).
            </p>
            <div class="progress">
              <div class="progress__bar" data-points-bar style="width: 0%"></div>
            </div>
            <div class="row row--space">
              <div class="chip" data-points-text>0 points</div>
              <div class="muted">Goal: 10 points toward free item</div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Floating Chat -->
    <button class="chat-fab" type="button" aria-label="Open chat" data-open-chat>
      <span aria-hidden="true">?</span>
    </button>
    <dialog class="modal" data-modal="chat" aria-label="Chatbox">
      <div class="modal__card">
        <button class="icon-btn modal__close" type="button" data-close-modal aria-label="Close">✕</button>
        <div class="modal__header">
          <div class="modal__art modal__art--chat" aria-hidden="true"></div>
          <div>
            <h3 class="h3">Questions</h3>
            <p class="muted">Ask about ingredients or allergies (placeholder).</p>
          </div>
        </div>
        <div class="modal__content">
          <form class="form" data-chat-form>
            <label class="field">
              <span class="field__label">Message</span>
              <textarea class="field__input" name="message" rows="4" placeholder="Type your question..."></textarea>
            </label>
            <label class="field">
              <span class="field__label">Email</span>
              <input class="field__input" type="email" name="email" placeholder="you@example.com">
            </label>
            <button class="btn btn--primary" type="submit">Submit</button>
            <p class="muted" data-chat-status></p>
          </form>
        </div>
      </div>
    </dialog>

    <!-- Cafe template JS -->
    <script src="{{ 'cafe-template.js' | asset_url }}" defer></script>
  </body>
</html>

